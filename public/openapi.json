{
  "openapi": "3.1.0",
  "info": {
    "title": "SEAPEDIA API",
    "version": "1.0.0",
    "description": "Documented HTTP API for the SEAPEDIA marketplace application."
  },
  "servers": [{ "url": "http://127.0.0.1:3001" }],
  "paths": {
    "/api/auth/sign-up/email": { "post": { "summary": "Register with Better Auth" } },
    "/api/auth/sign-in/username": { "post": { "summary": "Sign in with username and set session cookie" } },
    "/api/auth/role": { "post": { "summary": "Choose active role" } },
    "/api/auth/sign-out": { "post": { "summary": "Revoke the Better Auth session" } },
    "/api/profile": { "get": { "summary": "Read current profile" } },
    "/api/reviews": {
      "get": { "summary": "List public application reviews" },
      "post": { "summary": "Create public application review" }
    },
    "/api/products": { "get": { "summary": "List paginated products with q, category, page, and sort filters" } },
    "/api/products/{id}": { "get": { "summary": "Read public product detail" } },
    "/api/seller/store": {
      "get": { "summary": "Read seller store" },
      "post": { "summary": "Create or update seller store" }
    },
    "/api/seller/products": {
      "get": { "summary": "List seller products" },
      "post": { "summary": "Create seller product" }
    },
    "/api/seller/products/{id}": {
      "patch": { "summary": "Update seller product" },
      "delete": { "summary": "Delete seller product" }
    },
    "/api/seller/orders": { "get": { "summary": "List seller orders" } },
    "/api/seller/orders/{id}/process": {
      "post": { "summary": "Process order to Menunggu Pengirim" }
    },
    "/api/seller/reports": { "get": { "summary": "Seller income report" } },
    "/api/buyer/wallet": {
      "get": { "summary": "Read buyer wallet balance and ledger" }
    },
    "/api/buyer/wallet/topup": { "post": { "summary": "Wallet top-up" } },
    "/api/buyer/addresses": {
      "get": { "summary": "List delivery addresses" },
      "post": { "summary": "Create delivery address" }
    },
    "/api/buyer/cart": { "get": { "summary": "Read cart summary" } },
    "/api/buyer/cart/items": { "post": { "summary": "Add product to cart" } },
    "/api/buyer/cart/items/{id}": {
      "patch": { "summary": "Update cart item quantity" },
      "delete": { "summary": "Remove cart item" }
    },
    "/api/buyer/checkout/summary": {
      "post": { "summary": "Preview checkout totals (PPN, delivery, discount)" }
    },
    "/api/buyer/checkout": { "post": { "summary": "Atomically validate and create an order from cart" } },
    "/api/buyer/orders": { "get": { "summary": "List buyer orders" } },
    "/api/buyer/orders/{id}": {
      "get": { "summary": "Read order with status timeline" }
    },
    "/api/buyer/reports": { "get": { "summary": "Buyer spending report" } },
    "/api/driver/jobs": { "get": { "summary": "List available delivery jobs" } },
    "/api/driver/jobs/{id}/take": { "post": { "summary": "Take a delivery job" } },
    "/api/driver/jobs/{id}/complete": {
      "post": { "summary": "Complete a delivery job" }
    },
    "/api/driver/history": {
      "get": { "summary": "Driver completed jobs and earnings" }
    },
    "/api/admin/monitoring": { "get": { "summary": "Admin marketplace monitoring" } },
    "/api/admin/vouchers": {
      "get": { "summary": "List vouchers" },
      "post": { "summary": "Create percentage voucher" }
    },
    "/api/admin/promos": {
      "get": { "summary": "List promos" },
      "post": { "summary": "Create fixed-amount promo" }
    },
    "/api/admin/time": { "post": { "summary": "Advance the system clock (time machine)" } },
    "/api/admin/overdue": {
      "get": { "summary": "List overdue orders" },
      "post": { "summary": "Run auto return/refund" }
    }
  }
}
