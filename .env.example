# Copy this file to .env.local. Convex CLI will fill the deployment-specific
# values when `pnpm exec convex dev` is configured for a local deployment.
SESSION_SECRET=replace-with-at-least-32-random-characters

# Local Convex defaults. Leave CONVEX_DEPLOYMENT empty until the CLI fills it.
NEXT_PUBLIC_CONVEX_URL=
NEXT_PUBLIC_CONVEX_SITE_URL=
NEXT_PUBLIC_SITE_URL=http://127.0.0.1:3001
CONVEX_DEPLOYMENT=

# Better Auth configuration. Set both values in the local Convex deployment
# environment too; see README.md.
SITE_URL=http://127.0.0.1:3001
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters

# Development-only seed credential. Set the same value in Convex with
# `pnpm exec convex env set SEED_ACCOUNT_PASSWORD ...`.
SEED_ACCOUNT_PASSWORD=replace-with-a-development-password
