# --- Memory mode (default) ---
# Leave the Convex vars empty to run SEAPEDIA on the in-memory backend.
SESSION_SECRET=replace-with-at-least-32-random-characters

# --- Convex mode (real backend + Better Auth) ---
# Populated by `npx convex dev`. When NEXT_PUBLIC_CONVEX_URL is set, the app
# enables the Convex + Better Auth path.
NEXT_PUBLIC_CONVEX_URL=
NEXT_PUBLIC_CONVEX_SITE_URL=
CONVEX_DEPLOYMENT=

# Public site URL used as the Better Auth baseURL (Convex env var SITE_URL).
SITE_URL=http://localhost:3000
# Better Auth signing secret (also set in the Convex deployment env).
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
